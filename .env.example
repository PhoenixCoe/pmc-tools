SITE_URL=https://apps.pmcstudios.uk
# Sign in with a PMC ID (id.pmcstudios.uk). Use the same two values as Coe and PMC ID: the Supabase Project URL and the PUBLISHABLE key (sb_publishable_...). Never the secret key. Leave both empty and the site simply has no sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only if PMC ID is somewhere else (it is not, normally).
NEXT_PUBLIC_ACCOUNTS_URL=https://id.pmcstudios.uk
# App ideas from /suggest are emailed with this SMTP. Change the address here if needed.
SUGGEST_TO=ideas@pmcstudios.uk
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="PMC Apps <login@pmcstudios.uk>"
# Static copies (GitHub Pages) have no server: point this at a form service that forwards to the address above.
NEXT_PUBLIC_SUGGEST_ENDPOINT=
